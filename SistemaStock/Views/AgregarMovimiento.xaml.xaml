<Window x:Class="SistemaStock.Views.AgregarMovimiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar movimiento"
        Width="500"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- ================= COLORES ================= -->

        <SolidColorBrush x:Key="FondoPanel"
                         Color="#1D293D"/>

        <SolidColorBrush x:Key="FondoInput"
                         Color="#243249"/>

        <SolidColorBrush x:Key="TextoPrincipal"
                         Color="#F1F5F9"/>

        <SolidColorBrush x:Key="TextoSecundario"
                         Color="#94A3B8"/>


        <!-- ================= BOTÓN ================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#3B82F6"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="15,10"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#2563EB"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= TEXTBOX ================= -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="#243249"/>

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="BorderBrush"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="12"/>

        </Style>


        <!-- ================= COMBOBOX ================= -->

        <Style x:Key="ModernComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Background"
                    Value="#243249"/>

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="BorderBrush"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="10,5"/>

        </Style>


        <!-- ================= COMBOBOX ITEM ================= -->

        <Style x:Key="ModernComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Background"
                    Value="#243249"/>

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#334155"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ================= CONTENIDO ================= -->

    <Grid Margin="30">

        <Border Background="#1D293D"
                CornerRadius="14"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ================= TITULO ================= -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,25">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="40"
                                Height="40"
                                Background="#1E40AF"
                                CornerRadius="9">

                            <TextBlock Text="+"
                                       Foreground="#93C5FD"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="12,0,0,0">

                            <TextBlock Text="Agregar movimiento"
                                       Foreground="#F1F5F9"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Registrar actividad del inventario"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- ================= PRODUCTO ================= -->

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,17">

                    <TextBlock Text="PRODUCTO"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="cmbProducto"
                              Height="40"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"/>

                </StackPanel>


                <!-- ================= TIPO ================= -->

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,17">

                    <TextBlock Text="TIPO DE MOVIMIENTO"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="cmbTipoMovimiento"
                              Height="40"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}">

                        <ComboBoxItem Content="Entrada"/>
                        <ComboBoxItem Content="Salida"/>

                    </ComboBox>

                </StackPanel>


                <!-- ================= CANTIDAD ================= -->

                <StackPanel Grid.Row="3"
                            Margin="0,0,0,20">

                    <TextBlock Text="CANTIDAD"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtCantidad"
                             Height="40"
                             Style="{StaticResource ModernTextBoxStyle}"
                             PreviewTextInput="SoloNumeros_PreviewTextInput"/>

                </StackPanel>


                <!-- ================= BOTON ================= -->

                <Button Grid.Row="4"
                        Content="Guardar movimiento"
                        Width="190"
                        Height="43"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="GuardarMovimiento_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>