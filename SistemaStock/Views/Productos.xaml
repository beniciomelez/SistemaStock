<Window x:Class="SistemaStock.Views.Productos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos"
        Width="1100"
        Height="650"
        MinWidth="950"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Window.Resources>

        <!-- COLORES -->

        <SolidColorBrush x:Key="FondoPrincipal" Color="#111827"/>
        <SolidColorBrush x:Key="FondoPanel" Color="#1D293D"/>
        <SolidColorBrush x:Key="FondoPanelClaro" Color="#243249"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AzulPrincipal" Color="#3B82F6"/>


        <!-- BOTÓN PRINCIPAL -->

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTONES DE ACCIONES -->

        <Style x:Key="ActionButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#243249"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334B70"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- TEXTBOX BUSCADOR -->

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">

            <Setter Property="Background" Value="#1D293D"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>

        </Style>


        <!-- DATAGRID -->

        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="#1D293D"/>
            <Setter Property="Foreground" Value="#DCE6F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1D293D"/>
            <Setter Property="AlternatingRowBackground" Value="#202F46"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>

        </Style>


        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#243249"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="0"/>

        </Style>


        <Style TargetType="DataGridCell">

            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>

        </Style>

    </Window.Resources>


    <Grid Margin="30,28,30,30">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,28">

            <StackPanel>

                <TextBlock Text="Productos"
                           Foreground="#F1F5F9"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Administración y control del inventario"
                           Foreground="#94A3B8"
                           FontSize="13"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#1D293D"
                    CornerRadius="8"
                    Padding="12,8">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#22C55E"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="Inventario"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================= BUSCADOR ================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    Background="#1D293D"
                    CornerRadius="8"
                    BorderBrush="#334155"
                    BorderThickness="1">

                <Grid>

                    <TextBlock Text="⌕"
                               Foreground="#64748B"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <TextBox x:Name="txtBuscar"
                             Margin="42,0,10,0"
                             Height="42"
                             Background="Transparent"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="BuscarProducto_TextChanged"/>

                </Grid>

            </Border>


            <Button Grid.Column="1"
                    Content="+  Agregar producto"
                    Width="175"
                    Height="44"
                    Margin="15,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="AgregarProducto_Click"/>

        </Grid>


        <!-- ================= TABLA ================= -->

        <Border Grid.Row="2"
                Background="#1D293D"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- CABECERA TABLA -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="Listado de productos"
                                   Foreground="#F1F5F9"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Productos registrados en el sistema"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>


                <DataGrid x:Name="TablaProductos"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          RowHeight="45"
                          ColumnHeaderHeight="40"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="70"/>

                        <DataGridTextColumn Header="PRODUCTO"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>

                        <DataGridTextColumn Header="CATEGORÍA"
                                            Binding="{Binding Categoria}"
                                            Width="*"/>

                        <DataGridTextColumn Header="PRECIO"
                                            Binding="{Binding Precio}"
                                            Width="130"/>

                        <DataGridTextColumn Header="STOCK"
                                            Binding="{Binding Stock}"
                                            Width="110"/>


                        <DataGridTemplateColumn Header="ACCIONES"
                                                Width="180">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Content="Editar"
                                                Width="65"
                                                Height="28"
                                                Margin="0,0,7,0"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Click="EditarProducto_Click"/>

                                        <Button Content="Eliminar"
                                                Width="70"
                                                Height="28"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Click="EliminarProducto_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Window>