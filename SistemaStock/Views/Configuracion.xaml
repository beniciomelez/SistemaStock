<Window x:Class="SistemaStock.Views.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5"
          Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Configuración"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="Configuración general del sistema"
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="1">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Configuración de stock"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Stock mínimo predeterminado para nuevos productos"
                               FontSize="15"
                               Margin="0,10,0,10"/>

                    <StackPanel Orientation="Horizontal">

                        <TextBox x:Name="txtStockMinimo"
                                 Width="100"
                                 Height="35"
                                 FontSize="16"
                                 Text="10"
                                 Padding="8"/>

                        <Button Content="Guardar"
                                Width="100"
                                Height="35"
                                Margin="10,0,0,0"
                                Click="BtnGuardarStockMinimo_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Información del sistema"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Nombre del sistema: SistemaStock"
                               FontSize="15"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Versión: 1.0"
                               FontSize="15"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Base de datos: SQL Server"
                               FontSize="15"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Window>