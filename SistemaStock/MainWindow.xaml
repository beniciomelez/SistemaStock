<Window x:Class="SistemaStock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema Stock"
        Width="1200"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- MENÚ LATERAL -->

        <Border Grid.Column="0"
                Background="#1E1E2E">

            <StackPanel>

                <TextBlock Text="SISTEMA STOCK"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="20"/>

                <Button x:Name="btnInicio" Content="Inicio"
                        Margin="15,10"/>

                <Button x:Name="btnProductos" Content="Productos"
                        Margin="15,10" Click="btnProductos_Click"/>

                <Button x:Name="btnMovimientos" Content="Movimientos"
                        Margin="15,10" Click="btnMovimientos_Click"/>

                <Button x:Name="btnConfiguracion" Content="Configuración"
                        Margin="15,10" Click="btnConfiguracion_Click"/>

            </StackPanel>

        </Border>


        <!-- CONTENIDO -->

        <Border Grid.Column="1"
                Background="#F5F5F5">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- TÍTULO -->

                <StackPanel Grid.Row="0"
                Margin="0,0,0,25">

                    <TextBlock Text="Dashboard"
                   FontSize="32"
                   FontWeight="Bold"/>

                    <TextBlock Text="Resumen general del inventario"
                   FontSize="16"
                   Foreground="Gray"
                   Margin="0,5,0,0"/>

                </StackPanel>


                <!-- TARJETAS -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- PRODUCTOS -->

                    <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="Productos"
                           FontSize="16"/>

                            <TextBlock Text="0"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>

                            <TextBlock Text="Productos registrados"
                           Foreground="Gray"/>

                        </StackPanel>

                    </Border>


                    <!-- STOCK -->

                    <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="5,0">

                        <StackPanel>

                            <TextBlock Text="Stock total"
                           FontSize="16"/>

                            <TextBlock Text="0"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>

                            <TextBlock Text="Unidades disponibles"
                           Foreground="Gray"/>

                        </StackPanel>

                    </Border>


                    <!-- ALERTAS -->

                    <Border Grid.Column="2"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="10,0,0,0">

                        <StackPanel>

                            <TextBlock Text="Stock bajo"
                           FontSize="16"/>

                            <TextBlock Text="0"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>

                            <TextBlock Text="Productos para reponer"
                           Foreground="Gray"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ÚLTIMOS MOVIMIENTOS -->

                <Border Grid.Row="2"
            Background="White"
            CornerRadius="10"
            Margin="0,25,0,0"
            Padding="20">

                    <StackPanel>

                        <TextBlock Text="Últimos movimientos"
                       FontSize="20"
                       FontWeight="Bold"/>

                        <TextBlock Text="Todavía no hay movimientos registrados."
                       Foreground="Gray"
                       Margin="0,15,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>