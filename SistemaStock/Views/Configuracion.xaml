<Window x:Class="SistemaStock.Views.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="1100"
        Height="650"
        MinWidth="950"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Window.Resources>

        <!-- ================= COLORES ================= -->

        <SolidColorBrush x:Key="FondoPrincipal" Color="#111827"/>
        <SolidColorBrush x:Key="FondoPanel" Color="#1D293D"/>
        <SolidColorBrush x:Key="FondoPanelClaro" Color="#243249"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#94A3B8"/>


        <!-- ================= BOTÓN ================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#3B82F6"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="16,10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#2563EB"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================= TEXTBOX ================= -->

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="#243249"/>

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="BorderBrush"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="10"/>

        </Style>

    </Window.Resources>


    <!-- ================= CONTENIDO ================= -->

    <Grid Margin="30,28,30,30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,28">

            <StackPanel>

                <TextBlock Text="Configuración"
                           Foreground="#F1F5F9"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Configuración general del sistema"
                           Foreground="#94A3B8"
                           FontSize="13"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ESTADO -->

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#1D293D"
                    CornerRadius="8"
                    Padding="12,8">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#22C55E"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="Sistema operativo"
                               Foreground="#94A3B8"
                               FontSize="11"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================= CONTENIDO ================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================= STOCK ================= -->

            <Border Grid.Column="0"
                    Background="#1D293D"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- TITULO -->

                    <StackPanel Grid.Row="0">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="40"
                                    Height="40"
                                    Background="#1E40AF"
                                    CornerRadius="9">

                                <TextBlock Text="▥"
                                           Foreground="#93C5FD"
                                           FontSize="21"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Margin="12,0,0,0">

                                <TextBlock Text="Configuración de stock"
                                           Foreground="#F1F5F9"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Valores predeterminados"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </StackPanel>

                    </StackPanel>


                    <!-- DESCRIPCIÓN -->

                    <StackPanel Grid.Row="1"
                                Margin="0,30,0,0">

                        <TextBlock Text="Stock mínimo predeterminado"
                                   Foreground="#E2E8F0"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Cantidad mínima de unidades que tendrán los nuevos productos."
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                    </StackPanel>


                    <!-- INPUT -->

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="0,25,0,0">

                        <TextBox x:Name="txtStockMinimo"
                                 Width="120"
                                 Height="42"
                                 Text="10"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 VerticalContentAlignment="Center"/>

                        <Button Content="Guardar cambios"
                                Width="145"
                                Height="42"
                                Margin="12,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnGuardarStockMinimo_Click"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= INFORMACIÓN ================= -->

            <Border Grid.Column="1"
                    Background="#1D293D"
                    CornerRadius="12"
                    Padding="25"
                    Margin="10,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- TITULO -->

                    <StackPanel Grid.Row="0">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="40"
                                    Height="40"
                                    Background="#164E63"
                                    CornerRadius="9">

                                <TextBlock Text="i"
                                           Foreground="#67E8F9"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Margin="12,0,0,0">

                                <TextBlock Text="Información"
                                           Foreground="#F1F5F9"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Datos del sistema"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </StackPanel>

                    </StackPanel>


                    <!-- DATOS -->

                    <StackPanel Grid.Row="1"
                                Margin="0,30,0,0">


                        <!-- SISTEMA -->

                        <TextBlock Text="NOMBRE DEL SISTEMA"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="SistemaStock"
                                   Foreground="#E2E8F0"
                                   FontSize="14"
                                   Margin="0,6,0,22"/>


                        <!-- VERSION -->

                        <TextBlock Text="VERSIÓN"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="1.0"
                                   Foreground="#E2E8F0"
                                   FontSize="14"
                                   Margin="0,6,0,22"/>


                        <!-- BASE DE DATOS -->

                        <TextBlock Text="BASE DE DATOS"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="SQL Server"
                                   Foreground="#E2E8F0"
                                   FontSize="14"
                                   Margin="0,6,0,22"/>


                        <!-- ESTADO -->

                        <Border Background="#173B2A"
                                CornerRadius="7"
                                Padding="10"
                                Margin="0,5,0,0">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#22C55E"
                                         Margin="0,0,8,0"/>

                                <TextBlock Text="Base de datos conectada"
                                           Foreground="#86EFAC"
                                           FontSize="11"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>