<Window x:Class="SistemaStock.Views.AgregarProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar producto"
        Width="450"
        Height="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Agregar producto"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <TextBox x:Name="txtNombre"
                 Grid.Row="1"
                 Height="40"
                 Margin="0,0,0,15"
                 Padding="10"/>

        <TextBox x:Name="txtCategoria"
                 Grid.Row="2"
                 Height="40"
                 Margin="0,0,0,15"
                 Padding="10"/>

        <TextBox x:Name="txtPrecio"
                 Grid.Row="3"
                 Height="40"
                 Margin="0,0,0,15"
                 Padding="10"/>

        <TextBox x:Name="txtStock"
                 Grid.Row="4"
                 Height="40"
                 Margin="0,0,0,15"
                 Padding="10"/>

        <Button Grid.Row="5"
                Content="Agregar"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Click="Agregar_Click"/>

    </Grid>
</Window>