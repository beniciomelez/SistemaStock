<Window x:Class="SistemaStock.Views.AgregarProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar producto"
        Width="500"
        Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111827">

    <Window.Resources>

        <!-- ESTILO DE LOS INPUTS -->
        <Style x:Key="TextBoxConPlaceholder" TargetType="TextBox">

            <Setter Property="Background" Value="#243249"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>

                <!-- PLACEHOLDER -->
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush AlignmentX="Left"
                                         AlignmentY="Center"
                                         Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Padding="12,0,0,0"
                                               Foreground="#64748B"
                                               FontSize="14"
                                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="BotonPrincipal" TargetType="Button">

            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="20,10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <!-- PANEL -->
        <Border Background="#1D293D"
                CornerRadius="16"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- TÍTULO -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,25">

                    <TextBlock x:Name="txtTitulo"
                               Text="Agregar producto"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#F1F5F9"/>

                    <TextBlock Text="Completá los datos del nuevo producto"
                               FontSize="13"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- NOMBRE -->
                <TextBlock Grid.Row="1"
                           Text="NOMBRE DEL PRODUCTO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="txtNombre"
                         Grid.Row="2"
                         Height="42"
                         Margin="0,0,0,15"
                         Tag="Ej. Coca Cola 1.5L"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         PreviewTextInput="SoloTexto_PreviewTextInput"/>


                <!-- CATEGORÍA -->
                <TextBlock Grid.Row="3"
                           Text="CATEGORÍA"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="txtCategoria"
                         Grid.Row="4"
                         Height="42"
                         Margin="0,0,0,15"
                         Tag="Ej. Bebidas"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         PreviewTextInput="SoloTexto_PreviewTextInput"/>


                <!-- PRECIO -->
                <TextBlock Grid.Row="5"
                           Text="PRECIO ($)"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="txtPrecio"
                         Grid.Row="6"
                         Height="42"
                         Margin="0,0,0,15"
                         Tag="Ej. 10.99"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         PreviewTextInput="Precio_PreviewTextInput"/>


                <!-- STOCK -->
                <TextBlock Grid.Row="7"
                           Text="STOCK INICIAL"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="txtStock"
                         Grid.Row="8"
                         Height="42"
                         Margin="0,0,0,20"
                         Tag="Ej. 100"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         PreviewTextInput="SoloNumeros_PreviewTextInput"/>


                <!-- BOTÓN -->
                <Button x:Name="btnAgregar"
                        Grid.Row="9"
                        Content="Agregar producto"
                        Width="166"
                        Height="42"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BotonPrincipal}"
                        Click="Agregar_Click" Margin="0,35,0,46"/>

            </Grid>

        </Border>

    </Grid>

</Window>