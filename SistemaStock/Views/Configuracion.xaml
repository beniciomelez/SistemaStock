<Window x:Class="SistemaStock.Views.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5"
          Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TÍTULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Configuración"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="Configuración general del sistema"
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- OPCIONES -->

        <StackPanel Grid.Row="1">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Información del sistema"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Stock"
                               FontSize="16"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Versión 1.0"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <Border Background="White"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Preferencias"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <CheckBox Content="Mostrar alertas de stock bajo"
                              Margin="0,15,0,0"/>

                    <CheckBox Content="Mostrar confirmación antes de eliminar"
                              Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Window>